<local:CinePage x:Class="CineTrack.WatchlistPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:CineTrack"
                xmlns:c="clr-namespace:CineTrack.Controls"
                Title="Watchlist">
    <StackPanel>
        <Grid x:Name="HeaderGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl x:Name="HeaderHost" Focusable="False" IsTabStop="False"/>
            <Button x:Name="FindMoviesButton" Grid.Column="1" Style="{StaticResource Btn.Primary}" Content="Find movies to add"
                    c:Ui.Glyph="&#xE710;" VerticalAlignment="Bottom" Margin="24,0,0,6" Click="FindMovies_Click"/>
        </Grid>

        <Grid x:Name="LayoutGrid" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Main column ===== -->
            <StackPanel x:Name="MainColumn">
                <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,0,-16,0"/>

                <Grid x:Name="Toolbar" Margin="0,16,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel x:Name="Tabs" VerticalAlignment="Center"/>
                    <StackPanel x:Name="ToolbarRight" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,10">
                        <ComboBox x:Name="SortBox" Width="190" AutomationProperties.Name="Sort watchlist" SelectionChanged="SortBox_SelectionChanged"/>
                        <Button x:Name="GridViewButton" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE80A;" Margin="12,0,8,0"
                                AutomationProperties.Name="Grid view" ToolTip="Grid view" Click="GridView_Click"/>
                        <Button x:Name="ListViewButton" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE8FD;"
                                AutomationProperties.Name="List view" ToolTip="List view" Click="ListView_Click"/>
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="CardsGrid" Columns="2" Margin="0,0,-16,0" VerticalAlignment="Top"/>
                <ContentControl x:Name="EmptyHost" Focusable="False" IsTabStop="False"/>
            </StackPanel>

            <!-- ===== Sidebar ===== -->
            <StackPanel x:Name="Sidebar" Grid.Column="1" Margin="32,0,0,0">
                <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
                    <StackPanel>
                        <ContentControl x:Name="PicksHeader" Focusable="False" IsTabStop="False"/>
                        <StackPanel x:Name="PicksList"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Panel}" Text="Watchlist Stats" Margin="0,0,0,20"/>
                        <StackPanel x:Name="GenreBars"/>
                        <Border Background="{StaticResource DarkBurgundy}" BorderBrush="{StaticResource MutedGold}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE823;" Style="{StaticResource Text.Icon}" FontSize="22"
                                           Foreground="{StaticResource Gold}" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.Meta}" Text="Time to clear your list"/>
                                    <TextBlock x:Name="TimeToClear" Style="{StaticResource Text.Stat}" FontSize="28" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</local:CinePage>
