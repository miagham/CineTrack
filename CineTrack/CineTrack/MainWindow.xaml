<Window x:Class="CineTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CineTrack.Controls"
        Title="CineTrack: Personal Movie Companion"
        Width="1360" Height="900" MinWidth="360" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NearBlack}"
        FontFamily="{StaticResource Manrope}"
        Foreground="{StaticResource Cream}"
        UseLayoutRounding="True">
    <Grid>
        <!-- ===== Atmosphere: background only ===== -->
        <Border Background="{StaticResource DeepRed}"/>
        <Rectangle Fill="{StaticResource CurtainBrush}"/>
        <Rectangle Fill="{StaticResource GrainBrush}"/>
        <Rectangle Fill="{StaticResource VignetteBrush}"/>

        <DockPanel>
            <!-- ===== Header ===== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource DarkBurgundy}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid x:Name="HeaderGrid" MaxWidth="1600" Height="76" Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LogoButton" Style="{StaticResource Btn.Base}" Padding="4" Click="Home_Click"
                            AutomationProperties.Name="CineTrack home" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ReelGeometry}" Fill="{StaticResource Gold}" Width="28" Height="28"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontFamily="{StaticResource Playfair}" FontWeight="ExtraBold" FontSize="26" VerticalAlignment="Center">
                                <Run Text="Cine" Foreground="{StaticResource Cream}"/><Run Text="Track" Foreground="{StaticResource Gold}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <c:SearchBar x:Name="HeaderSearch" Grid.Column="1" MaxWidth="460" Margin="28,0" VerticalAlignment="Center"/>
                    <Button x:Name="SearchIconButton" Grid.Column="1" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right"
                            Margin="0,0,16,0" VerticalAlignment="Center" c:Ui.Glyph="&#xE721;"
                            AutomationProperties.Name="Search" ToolTip="Search" Click="SearchIcon_Click"/>

                    <StackPanel x:Name="NavLinks" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NavHome" Style="{StaticResource Btn.Nav}" Content="Home" Click="Home_Click"/>
                        <Button x:Name="NavDiscover" Style="{StaticResource Btn.Nav}" Content="Discover" Click="Discover_Click"/>
                        <Button x:Name="NavMyMovies" Style="{StaticResource Btn.Nav}" Content="My Movies" Click="MyMovies_Click"/>
                        <Button x:Name="NavWatchlist" Style="{StaticResource Btn.Nav}" Content="Watchlist" Click="Watchlist_Click"/>
                    </StackPanel>

                    <Button x:Name="ProfileButton" Grid.Column="3" Style="{StaticResource Btn.Secondary}" Content="Profile"
                            c:Ui.Glyph="&#xE77B;" Padding="18,10" Margin="16,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource TextMuted}" Click="Profile_Click"/>

                    <Button x:Name="MenuButton" Grid.Column="4" Style="{StaticResource Btn.Icon}" c:Ui.Glyph="&#xE700;"
                            Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Menu" ToolTip="Menu"
                            Click="Menu_Click"/>
                    <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom"
                           HorizontalOffset="-180" VerticalOffset="10" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource NearBlack}" BorderBrush="{StaticResource MutedGold}" BorderThickness="1"
                                CornerRadius="16" Padding="10" Width="220">
                            <StackPanel x:Name="MenuLinks" KeyboardNavigation.TabNavigation="Cycle">
                                <Button Style="{StaticResource Btn.Nav}" Content="Home" HorizontalContentAlignment="Left" Click="Home_Click"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Discover" Click="Discover_Click"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="My Movies" Click="MyMovies_Click"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Watchlist" Click="Watchlist_Click"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Profile" Click="Profile_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ===== Page area with film-strip edges ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftStripColumn" Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightStripColumn" Width="16"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{StaticResource FilmStripVertical}"/>
                <Rectangle Grid.Column="2" Fill="{StaticResource FilmStripVertical}"/>

                <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                    <StackPanel>
                        <Border x:Name="ContentColumn" MaxWidth="1600" Padding="32,48,32,0">
                            <Frame x:Name="PageFrame" NavigationUIVisibility="Hidden" Focusable="False" IsTabStop="False"
                                   JournalOwnership="OwnsJournal" Navigated="PageFrame_Navigated"/>
                        </Border>

                        <!-- ===== Footer ===== -->
                        <Rectangle Height="16" Fill="{StaticResource FilmStripHorizontal}" Margin="0,88,0,0"/>
                        <Border Background="{StaticResource NearBlack}">
                            <Grid x:Name="FooterGrid" MaxWidth="1600" Margin="32,36,32,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource Playfair}" FontWeight="ExtraBold" FontSize="24">
                                        <Run Text="Cine" Foreground="{StaticResource Cream}"/><Run Text="Track" Foreground="{StaticResource Gold}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Meta}" FontSize="14" TextWrapping="Wrap" TextTrimming="None"
                                               Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                               Text="Your personal movie companion. Your lists stay on your device."/>
                                </StackPanel>
                                <StackPanel x:Name="FooterRight" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <WrapPanel x:Name="FooterLinks" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Btn.Link}" Foreground="{StaticResource Cream}" Content="Home" Click="Home_Click"/>
                                        <TextBlock Style="{StaticResource Text.Meta}" Text="·" Margin="6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Btn.Link}" Foreground="{StaticResource Cream}" Content="Discover" Click="Discover_Click"/>
                                        <TextBlock Style="{StaticResource Text.Meta}" Text="·" Margin="6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Btn.Link}" Foreground="{StaticResource Cream}" Content="My Movies" Click="MyMovies_Click"/>
                                        <TextBlock Style="{StaticResource Text.Meta}" Text="·" Margin="6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Btn.Link}" Foreground="{StaticResource Cream}" Content="Watchlist" Click="Watchlist_Click"/>
                                        <TextBlock Style="{StaticResource Text.Meta}" Text="·" Margin="6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Btn.Link}" Foreground="{StaticResource Cream}" Content="About" Click="About_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="Copyright" Style="{StaticResource Text.Meta}" Text="© 2026 CineTrack"
                                               HorizontalAlignment="Right" Margin="0,8,4,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ===== Drawer (Discover filters on tablet/mobile) ===== -->
        <Grid x:Name="DrawerOverlay" Visibility="Collapsed">
            <Border Background="{StaticResource Scrim}" MouseLeftButtonUp="DrawerScrim_Click"/>
            <Border x:Name="DrawerPanel" Background="{StaticResource NearBlack}" BorderBrush="{StaticResource MutedGold}"
                    BorderThickness="1,0,0,0" Width="340" HorizontalAlignment="Right"
                    KeyboardNavigation.TabNavigation="Cycle">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,20,16,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.IconSmall}" c:Ui.Glyph="&#xE711;"
                                AutomationProperties.Name="Close" Click="DrawerClose_Click"/>
                        <TextBlock x:Name="DrawerTitle" Style="{StaticResource Text.Panel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ContentControl x:Name="DrawerHost" Focusable="False" IsTabStop="False" Margin="24,8,24,24"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Rating prompt ===== -->
        <Grid x:Name="RatingOverlay" Visibility="Collapsed" Background="{StaticResource Scrim}">
            <Border Style="{StaticResource Panel}" MaxWidth="460" Margin="16" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource MutedGold}"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel x:Name="RatingContent"/>
            </Border>
        </Grid>

        <!-- ===== Toast ===== -->
        <c:PillBorder x:Name="Toast" Visibility="Collapsed" Opacity="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,32" Background="{StaticResource NearBlack}" BorderBrush="{StaticResource MutedGold}"
                BorderThickness="1" Padding="20,10,12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Gold}" FontSize="14" Margin="0,0,12,0"/>
                <TextBlock x:Name="ToastText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="480" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="ToastUndo" Style="{StaticResource Btn.Link}" Content="Undo" Margin="12,0,0,0" Padding="10,6"
                        Click="ToastUndo_Click"/>
            </StackPanel>
        </c:PillBorder>
    </Grid>
</Window>
